# Runtime check image: a newer distro (like SteamOS) with only runtime libraries, a virtual
# X server and screenshot tools. The release binary from build-linux.sh is mounted in and
# started under Xvfb to prove it links, opens a window and renders.
FROM --platform=linux/amd64 debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libx11-6 libxext6 libxrandr2 libxcursor1 libxi6 libxss1 libxfixes3 libxinerama1 \
        libxkbcommon0 libwayland-client0 libwayland-egl1 libegl1 libgl1 libgles2 libgbm1 \
        libasound2t64 libpulse0 libudev1 libdbus-1-3 \
        xvfb xauth x11-apps imagemagick ca-certificates \
    && rm -rf /var/lib/apt/lists/*
